# ==============================================================================
# eBPF/XDP DDoS Detection & Mitigation Pipeline - Environment Configuration
# ==============================================================================
# Copy this file to '.env' to override default directory paths and parameters.
# All paths can be relative (to repository root) or absolute.

# Path to filtered PCAP directory (contains 01-12/, 03-11/, TRex/)
# Default: ./pcap
PCAP_DIR=./pcap

# Path to CSV datasets and locked split indices
# Default: ./data
DATA_DIR=./data

# Path to trained model binaries (.joblib) and eBPF C headers (.h)
# Default: ./models
MODELS_DIR=./models

# Output path for standalone publication plots (PNG / PDF)
# Default: ./plots
PLOTS_DIR=./plots

# Output path for metrics summary tables (CSV / Markdown)
# Default: ./tables
TABLES_DIR=./tables

# Window duration in nanoseconds (1 second = 1,000,000,000 ns)
WINDOW_NS=1000000000
